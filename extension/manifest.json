{
  "manifest_version": 3,
  "name": "forkOS Capture",
  "version": "0.2.0",
  "description": "Inbox, Obsidian, görev ve kariyer/akademi için kullanıcı kontrollü yakalama.",
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "forkOS'a kaydet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Sayfayi Inbox'a kaydet"
    }
  }
}
