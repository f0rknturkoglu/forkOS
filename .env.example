POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos
POSTGRES_DB=lifeos
POSTGRES_PORT=5433

# Baglanti havuzu (API ve worker ayni ayarlari kullanir). Tek kullanicili
# local-first kurulum icin kucuk varsayilan yeterli; buyutmeye gerek yok.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Portlarin hangi adrese baglanacagi. Varsayilan 127.0.0.1 = sadece bu makine.
# Podman machine (Windows/macOS) kullaniyorsan 0.0.0.0 YAP: podman VM'in
# loopback'ine baglar ve host tarayicisi 127.0.0.1:5173'e ulasamaz. VM NAT'li
# oldugu icin 0.0.0.0 servisi LAN'a acmaz. Native Linux podman/docker'da
# 127.0.0.1 birak -- orada 0.0.0.0 gercekten disari acar.
BIND_ADDR=127.0.0.1

# Saat dilimi: Gun siniri (emek haritasi, gunluk ozet, A3 oturum devri) bu
# bolgeye gore hesaplanir. Container UTC kosar; burasi kullanicinin saat dilimidir.
TIMEZONE=Europe/Istanbul

# Container log surucusu (json-file veya Docker icin local). 10m/3 dosya rotasyonu aktif.
# LOG_DRIVER=json-file

# chrome://extensions -> extension'i yukleyince oradaki ID'yi buraya yaz
EXTENSION_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/google/callback

# RSS worker
# Varsayilan kapali: header yenilemesi kaynaklari API arka planinda tek tur ceker.
WORKER_ENABLED=0
RSS_DEFAULT_INTERVAL_MINUTES=60
RSS_RETENTION_DAYS=90

# H4 Yerel Bilis Router'i (Ollama tabanli yerel cikarim)
# Varsayilan KAPALI: zorunlu bagimlilik degildir. Kapaliyken arac devrede kalir
# ve H4_DISABLED doner. Yalnizca loopback (127.0.0.1 / localhost) kabul edilir.
H4_ENABLED=0
H4_OLLAMA_BASE_URL=http://127.0.0.1:11434
H4_SMALL_MODEL=
H4_MEDIUM_MODEL=
H4_SMALL_INPUT_CHARS=12000
H4_MEDIUM_INPUT_CHARS=24000
H4_TIMEOUT_SECONDS=45.0

# A3 Epizodik damitma butcesi (saniye).
A3_EXTRACTION_BUDGET_SECONDS=2.0

# A5.1 Context Judge (opt-in; off means no provider request).
# Native API defaults to http://127.0.0.1:8000.
# Docker Desktop/OrbStack Compose defaults to the approved host.docker.internal bridge.
A5_CONTEXT_MODE=off
A5_CONTEXT_TIMEOUT_SECONDS=1.5

# A5.2 Memory Judge (opt-in local poorjev / NLI provider; default off).
# Standart API imajinda model yuklenmez; compose.memory.yaml overlay'i ile kullanilir.
A5_MEMORY_MODE=off
A5_MEMORY_PROVIDER=poorjev
A5_MEMORY_MODEL_PATH=
A5_MEMORY_TIMEOUT_SECONDS=20.0

# A5.3 Answer Evidence Judge (opt-in local poorjev / NLI provider; default off).
# A5.2 ile ayni model agirliklarini (/opt/forkos/a5-memory-model) paylasir.
A5_ANSWER_MODE=off
A5_ANSWER_PROVIDER=poorjev
A5_ANSWER_MODEL_PATH=
A5_ANSWER_TIMEOUT_SECONDS=20.0

# LinkedIn (opt-in kaynak -- slow_optin, genel yenilemeye GIRMEZ)
# Direct (proxy'siz) erisim VARSAYILAN KAPALI. "0"/"false"/"no" kapali sayilir.
FORKJOB_LINKEDIN_ALLOW_DIRECT=0
# Proxy listesi dosyasi (her satirda bir proxy). Verilmezse proxy'siz calisamaz.
FORKJOB_LINKEDIN_PROXIES_FILE=

# Optional Obsidian knowledge vault (hibrit mimari).
# Onerilen duzen: Vault forkOS reposunun kardesidir (sibling), icinde degildir.
#
# 1. Yerel / Native calistirma icin:
# OBSIDIAN_VAULT_PATH=../Vault
# OBSIDIAN_VAULT_NAME=Vault
#
# 2. Container (Docker/Podman) runtime icin (make up-obsidian):
# Host uzerindeki Vault yolunu tanimlayin (compose.obsidian.yaml bunu /obsidian-vault olarak baglar):
OBSIDIAN_VAULT_HOST_PATH=
OBSIDIAN_VAULT_PATH=
OBSIDIAN_VAULT_NAME=

# Pinli career-ops motoru. Compose API/worker icin aciktir; kurulumu
# `make career-ops-setup` ile tamamla. Istenirse 0 ile kapatilabilir.
CAREER_OPS_ENABLED=1

# Empty = repo-managed .vendor/career-ops checkout.
CAREER_OPS_ROOT=

# Node.js binary path or name (requires Node >= 18, recommended >= 22.5).
CAREER_OPS_NODE_BIN=node
CAREER_OPS_TIMEOUT_SECONDS=30.0
CAREER_OPS_MAX_BUFFER_BYTES=524288

# Empty = backend/data/runtime/career-ops isolated scratch workspace.
CAREER_OPS_RUNTIME_DIR=

# Reverse ATS ve ek public provider kesif sinirlari
CAREER_OPS_DISCOVERY_ENABLED=1
CAREER_OPS_DISCOVERY_TIMEOUT_SECONDS=300.0
CAREER_OPS_DISCOVERY_SINCE_DAYS=7
CAREER_OPS_DISCOVERY_LIMIT=200
CAREER_OPS_DISCOVERY_MAX_BUFFER_BYTES=4194304
