POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos
POSTGRES_DB=lifeos
POSTGRES_PORT=5433

# Baglanti havuzu (API ve worker ayni ayarlari kullanir). Tek kullanicili
# local-first kurulum icin kucuk varsayilan yeterli; buyutmeye gerek yok.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Portlarin hangi adrese baglanacagi. Varsayilan 127.0.0.1 = sadece bu makine.
# Podman machine (Windows/macOS) kullaniyorsan 0.0.0.0 YAP: podman VM'in
# loopback'ine baglar ve host tarayicisi 127.0.0.1:5173'e ulasamaz. VM NAT'li
# oldugu icin 0.0.0.0 servisi LAN'a acmaz. Native Linux podman/docker'da
# 127.0.0.1 birak -- orada 0.0.0.0 gercekten disari acar.
BIND_ADDR=127.0.0.1

# Container log surucusu (json-file veya Docker icin local). 10m/3 dosya rotasyonu aktif.
# LOG_DRIVER=json-file

# chrome://extensions -> extension'i yukleyince oradaki ID'yi buraya yaz
EXTENSION_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/google/callback

# RSS worker
# Varsayilan kapali: header yenilemesi kaynaklari API arka planinda tek tur ceker.
WORKER_ENABLED=0
RSS_DEFAULT_INTERVAL_MINUTES=60
RSS_RETENTION_DAYS=90

# LinkedIn (opt-in kaynak -- slow_optin, genel yenilemeye GIRMEZ)
# Direct (proxy'siz) erisim VARSAYILAN KAPALI. "0"/"false"/"no" kapali sayilir.
FORKJOB_LINKEDIN_ALLOW_DIRECT=0
# Proxy listesi dosyasi (her satirda bir proxy). Verilmezse proxy'siz calisamaz.
FORKJOB_LINKEDIN_PROXIES_FILE=
# Optional Obsidian knowledge vault (hibrit mimari).
# Onerilen duzen: Vault forkOS reposunun kardesidir (sibling), icinde degildir.
#
# 1. Yerel / Native calistirma icin:
# OBSIDIAN_VAULT_PATH=../Vault
# OBSIDIAN_VAULT_NAME=Vault
#
# 2. Container (Docker/Podman) runtime icin (make up-obsidian):
# Host uzerindeki Vault yolunu tanimlayin (compose.obsidian.yaml bunu /obsidian-vault olarak baglar):
OBSIDIAN_VAULT_HOST_PATH=
OBSIDIAN_VAULT_PATH=
OBSIDIAN_VAULT_NAME=
